# Image Processing Tools

@tool
@traceable(name="cache_user_images")
def cache_user_images(user_phone: str, image_urls: List[str]) -> Dict[str, Any]:
    """
    Cache uploaded images for a user in Redis for later analysis.
    
    WORKFLOW:
    1. Store image URLs in Redis with user phone as key
    2. Set expiration time (e.g., 1 hour)
    3. Return confirmation of cached images
    
    Args:
        user_phone: User's phone number (used as Redis key)
        image_urls: List of image URLs to cache
        
    Returns:
        Dictionary with caching result:
        {
            "success": bool,
            "cached_count": int,
            "cache_key": str,
            "expires_at": str,
            "message": str
        }
        Use a single asterisk (*John Doe*) on each side whenever you make text bold; don't use double asterisks.
    """
    try:
        import redis
        import json
        from datetime import datetime, timedelta
        
        # Get Redis connection from settings
        settings = get_settings()
        
        # Construct Redis URL from settings
        redis_url = f"redis://"
        if settings.redis_password:
            redis_url += f":{settings.redis_password}@"
        redis_url += f"{settings.redis_host}:{settings.redis_port}/{settings.redis_db}"
        
        redis_client = redis.from_url(redis_url)
        
        # Create cache key
        cache_key = f"user_images:{user_phone}"
        
        # Prepare image data with individual image tracking
        image_data = {
            "user_phone": user_phone,
            "image_urls": image_urls,
            "uploaded_at": datetime.now().isoformat(),
            "count": len(image_urls),
            "images": []
        }
        
        # Create individual image entries with IDs
        for i, url in enumerate(image_urls):
            image_entry = {
                "id": f"img_{i+1}_{datetime.now().strftime('%Y%m%d_%H%M%S')}",
                "url": url,
                "uploaded_at": datetime.now().isoformat(),
                "analyzed": False,
                "analysis": None,
                "analysis_timestamp": None
            }
            image_data["images"].append(image_entry)
        
        # Cache in Redis with 1 hour expiration
        expiration_time = timedelta(hours=1)
        redis_client.setex(
            cache_key,
            expiration_time,
            json.dumps(image_data)
        )
        
        expires_at = (datetime.now() + expiration_time).isoformat()
        
        logger.info(f"Cached {len(image_urls)} images for user {user_phone}")
        
        return {
            "success": True,
            "cached_count": len(image_urls),
            "cache_key": cache_key,
            "expires_at": expires_at,
            "message": f"Successfully cached {len(image_urls)} images. They will expire at {expires_at}"
        }
        
    except Exception as e:
        logger.error(f"Error caching images for user {user_phone}: {e}")
        return {
            "success": False,
            "cached_count": 0,
            "cache_key": "",
            "expires_at": "",
            "message": f"Failed to cache images: {str(e)}"
        }


@tool
@traceable(name="append_user_images")
def append_user_images(user_phone: str, image_urls: List[str], clear_previous: bool = True) -> Dict[str, Any]:
    """
    [DEPRECATED FOR TRADE-INS] Append new images to existing user cache or create new cache if none exists.
    
    IMPORTANT: For trade-in workflows, DO NOT use this tool. Images are automatically stored in the database
    when uploaded via WhatsApp. This tool is only for legacy Redis-based caching and should not be used for trade-ins.
    
    WORKFLOW:
    1. If clear_previous=True: Clear any existing cached images for this user
    2. Create new cache with these images (fresh trade-in session)
    3. Return confirmation of cached images
    
    Args:
        user_phone: User's phone number (used as Redis key)
        image_urls: List of image URLs to append
        clear_previous: Whether to clear previous images (default: True for new trade-in sessions)
        
    Returns:
        Dictionary with caching result:
        {
            "success": bool,
            "total_cached_count": int,
            "new_images_count": int,
            "cache_key": str,
            "expires_at": str,
            "message": str
        }
        Use a single asterisk (*John Doe*) on each side whenever you make text bold; don't use double asterisks.
    """
    try:
        import redis
        import json
        from datetime import datetime, timedelta
        
        # Get Redis connection from settings
        settings = get_settings()
        
        # Construct Redis URL from settings
        redis_url = f"redis://"
        if settings.redis_password:
            redis_url += f":{settings.redis_password}@"
        redis_url += f"{settings.redis_host}:{settings.redis_port}/{settings.redis_db}"
        
        redis_client = redis.from_url(redis_url)
        
        # Create cache key
        cache_key = f"user_images:{user_phone}"
        
        # Clear previous images if requested (new trade-in session)
        if clear_previous:
            redis_client.delete(cache_key)
            logger.info(f"Cleared previous images for user {user_phone} (new trade-in session)")
        
        # Check if cache still exists after clearing
        existing_data = redis_client.get(cache_key)
        
        if existing_data and not clear_previous:
            # Append to existing cache (only if not clearing previous)
            image_data = json.loads(existing_data)
            existing_images = image_data.get("images", [])
            existing_count = len(existing_images)
            
            # Add new images to existing list
            for i, url in enumerate(image_urls):
                image_entry = {
                    "id": f"img_{existing_count + i + 1}_{datetime.now().strftime('%Y%m%d_%H%M%S')}",
                    "url": url,
                    "uploaded_at": datetime.now().isoformat(),
                    "analyzed": False,
                    "analysis": None,
                    "analysis_timestamp": None
                }
                existing_images.append(image_entry)
            
            # Update image data
            image_data["images"] = existing_images
            image_data["count"] = len(existing_images)
            image_data["image_urls"] = [img["url"] for img in existing_images]
            
            total_count = len(existing_images)
            new_count = len(image_urls)
            
        else:
            # Create new cache (fresh trade-in session)
            image_data = {
                "user_phone": user_phone,
                "image_urls": image_urls,
                "uploaded_at": datetime.now().isoformat(),
                "count": len(image_urls),
                "session_id": f"session_{datetime.now().strftime('%Y%m%d_%H%M%S')}",
                "images": []
            }
            
            # Create individual image entries with IDs
            for i, url in enumerate(image_urls):
                image_entry = {
                    "id": f"img_{i+1}_{datetime.now().strftime('%Y%m%d_%H%M%S')}",
                    "url": url,
                    "uploaded_at": datetime.now().isoformat(),
                    "analyzed": False,
                    "analysis": None,
                    "analysis_timestamp": None
                }
                image_data["images"].append(image_entry)
            
            total_count = len(image_urls)
            new_count = len(image_urls)
        
        # Cache in Redis with 1 hour expiration
        expiration_time = timedelta(hours=1)
        redis_client.setex(
            cache_key,
            expiration_time,
            json.dumps(image_data)
        )
        
        expires_at = (datetime.now() + expiration_time).isoformat()
        
        logger.info(f"Appended {new_count} images to cache for user {user_phone}. Total: {total_count}")
        
        return {
            "success": True,
            "total_cached_count": total_count,
            "new_images_count": new_count,
            "cache_key": cache_key,
            "expires_at": expires_at,
            "message": f"Successfully appended {new_count} images. Total cached: {total_count}. Expires at {expires_at}"
        }
        
    except Exception as e:
        logger.error(f"Error appending images for user {user_phone}: {e}")
        return {
            "success": False,
            "total_cached_count": 0,
            "new_images_count": 0,
            "cache_key": "",
            "expires_at": "",
            "message": f"Failed to append images: {str(e)}"
        }


@tool
@traceable(name="analyze_individual_image")
def analyze_individual_image(image_id: str, analysis_prompt: str = "Analyze this image and provide a detailed description.") -> Dict[str, Any]:
    """
    Analyze a single cached image by its ID.
    
    WORKFLOW:
    1. Find the image in Redis cache by ID
    2. Use vision-capable LLM to analyze the image
    3. Store the analysis result back in cache
    4. Return analysis result
    
    Args:
        image_id: ID of the image to analyze
        analysis_prompt: Custom prompt for image analysis
        
    Returns:
        Dictionary with analysis result:
        {
            "success": bool,
            "image_id": str,
            "analysis": str,
            "analysis_timestamp": str,
            "message": str
        }
        Use a single asterisk (*John Doe*) on each side whenever you make text bold; don't use double asterisks.
    """
    try:
        import redis
        import json
        from datetime import datetime
        from langchain_openai import ChatOpenAI
        from langchain_core.messages import HumanMessage
        
        # Get Redis connection
        settings = get_settings()
        
        # Construct Redis URL from settings
        redis_url = f"redis://"
        if settings.redis_password:
            redis_url += f":{settings.redis_password}@"
        redis_url += f"{settings.redis_host}:{settings.redis_port}/{settings.redis_db}"
        
        redis_client = redis.from_url(redis_url)
        
        # Find the image in any user's cache
        image_found = False
        user_phone = None
        image_url = None
        
        for key in redis_client.scan_iter(match="user_images:*"):
            key_str = key.decode('utf-8')
            cached_data = redis_client.get(key)
            if cached_data:
                image_data = json.loads(cached_data)
                for img in image_data.get("images", []):
                    if img.get("id") == image_id:
                        image_found = True
                        user_phone = image_data.get("user_phone")
                        image_url = img.get("url")
                        break
                if image_found:
                    break
        
        if not image_found:
            return {
                "success": False,
                "image_id": image_id,
                "analysis": "",
                "analysis_timestamp": "",
                "message": f"Image with ID {image_id} not found in cache."
            }
        
        # Initialize vision-capable LLM
        llm = ChatOpenAI(
            model="gpt-4o",  # Use GPT-4o for vision capabilities
            temperature=0.1,
            api_key=settings.openai_api_key
        )
        
        # Prepare analysis prompt
        full_prompt = f"{analysis_prompt}\n\nPlease analyze this image and provide a detailed description:"
        
        # Create message with image
        message_content = [
            {"type": "text", "text": full_prompt},
            {"type": "image_url", "image_url": {"url": image_url}}
        ]
        
        # Create human message with image
        human_message = HumanMessage(content=message_content)
        
        # Get analysis from LLM
        response = llm.invoke([human_message])
        analysis = response.content
        
        # Update the cache with the analysis
        cache_key = f"user_images:{user_phone}"
        cached_data = redis_client.get(cache_key)
        if cached_data:
            image_data = json.loads(cached_data)
            for img in image_data.get("images", []):
                if img.get("id") == image_id:
                    img["analyzed"] = True
                    img["analysis"] = analysis
                    img["analysis_timestamp"] = datetime.now().isoformat()
                    break
            
            # Save updated data back to cache
            redis_client.setex(cache_key, 3600, json.dumps(image_data))  # 1 hour expiration
        
        analysis_timestamp = datetime.now().isoformat()
        
        logger.info(f"Analyzed individual image {image_id} for user {user_phone}")
        
        return {
            "success": True,
            "image_id": image_id,
            "analysis": analysis,
            "analysis_timestamp": analysis_timestamp,
            "message": f"Successfully analyzed image {image_id}"
        }
        
    except Exception as e:
        logger.error(f"Error analyzing individual image {image_id}: {e}")
        return {
            "success": False,
            "image_id": image_id,
            "analysis": "",
            "analysis_timestamp": "",
            "message": f"Failed to analyze image {image_id}: {str(e)}"
        }


@tool
@traceable(name="analyze_cached_images")
def analyze_cached_images(analysis_prompt: str = "Analyze these images and provide a detailed description of what you see.") -> Dict[str, Any]:
    """
    Retrieve cached images for a user and analyze them using an LLM.
    
    WORKFLOW:
    1. Retrieve cached images from Redis
    2. Use vision-capable LLM to analyze images
    3. Return detailed analysis results
    4. Clear cache after analysis
    
    Args:
        analysis_prompt: Custom prompt for image analysis
        
    Returns:
        Dictionary with analysis results:
        {
            "success": bool,
            "analysis": str,
            "image_count": int,
            "analysis_timestamp": str,
            "message": str
        }
        Use a single asterisk (*John Doe*) on each side whenever you make text bold; don't use double asterisks.
    """
    try:
        import redis
        import json
        from datetime import datetime
        from langchain_openai import ChatOpenAI
        from langchain_core.messages import HumanMessage
        
        # Get Redis connection
        settings = get_settings()
        
        # Construct Redis URL from settings
        redis_url = f"redis://"
        if settings.redis_password:
            redis_url += f":{settings.redis_password}@"
        redis_url += f"{settings.redis_host}:{settings.redis_port}/{settings.redis_db}"
        
        redis_client = redis.from_url(redis_url)
        
        # Find the user phone number by checking all cached images
        # This is a workaround since the agent isn't passing the user_phone correctly
        user_phone = None
        for key in redis_client.scan_iter(match="user_images:*"):
            key_str = key.decode('utf-8')
            user_phone = key_str.replace("user_images:", "")
            break  # Use the first found user
        
        if not user_phone:
            return {
                "success": False,
                "analysis": "",
                "image_count": 0,
                "analysis_timestamp": "",
                "message": "No cached images found. Please upload images first."
            }
        
        # Create cache key
        cache_key = f"user_images:{user_phone}"
        
        # Retrieve cached images
        cached_data = redis_client.get(cache_key)
        if not cached_data:
            return {
                "success": False,
                "analysis": "",
                "image_count": 0,
                "analysis_timestamp": "",
                "message": "No cached images found for this user. Please upload images first."
            }
        
        # Parse cached data
        image_data = json.loads(cached_data)
        image_urls = image_data.get("image_urls", [])
        
        if not image_urls:
            return {
                "success": False,
                "analysis": "",
                "image_count": 0,
                "analysis_timestamp": "",
                "message": "No images found in cache for this user."
            }
        
        # Initialize vision-capable LLM
        llm = ChatOpenAI(
            model="gpt-4o",  # Use GPT-4o for vision capabilities
            temperature=0.1,
            api_key=settings.openai_api_key
        )
        
        # Prepare analysis prompt
        full_prompt = f"{analysis_prompt}\n\nPlease analyze the following images and provide a detailed description:"
        
        # Create message with images
        message_content = [
            {"type": "text", "text": full_prompt}
        ]
        
        # Add images to message content
        for i, image_url in enumerate(image_urls):
            message_content.append({
                "type": "image_url",
                "image_url": {"url": image_url}
            })
        
        # Create human message with images
        human_message = HumanMessage(content=message_content)
        
        # Get analysis from LLM
        response = llm.invoke([human_message])
        analysis = response.content
        
        # Clear cache after analysis
        redis_client.delete(cache_key)
        
        analysis_timestamp = datetime.now().isoformat()
        
        logger.info(f"Analyzed {len(image_urls)} images for user {user_phone}")
        
        return {
            "success": True,
            "analysis": analysis,
            "image_count": len(image_urls),
            "analysis_timestamp": analysis_timestamp,
            "message": f"Successfully analyzed {len(image_urls)} images"
        }
        
    except Exception as e:
        logger.error(f"Error analyzing cached images for user {user_phone}: {e}")
        return {
            "success": False,
            "analysis": "",
            "image_count": 0,
            "analysis_timestamp": "",
            "message": f"Failed to analyze images: {str(e)}"
        }


@tool
@traceable(name="process_all_cached_images")
def process_all_cached_images(analysis_prompt: str = "Analyze each image individually and then provide an overall summary.", user_phone: str = None) -> Dict[str, Any]:
    """
    Process all cached images for a user: analyze each individually, then provide overall analysis.
    
    WORKFLOW:
    1. Find all cached images for the user
    2. Analyze each image individually using analyze_individual_image
    3. Store individual analyses in cache
    4. Generate overall analysis based on all individual analyses
    5. Return comprehensive results
    
    Args:
        analysis_prompt: Custom prompt for image analysis
        
    Returns:
        Dictionary with comprehensive analysis results:
        {
            "success": bool,
            "total_images": int,
            "analyzed_images": int,
            "individual_analyses": List[Dict],
            "overall_analysis": str,
            "processing_timestamp": str,
            "message": str
        }
        Use a single asterisk (*John Doe*) on each side whenever you make text bold; don't use double asterisks.
    """
    try:
        import redis
        import json
        from datetime import datetime
        from langchain_openai import ChatOpenAI
        from langchain_core.messages import HumanMessage
        
        # Get Redis connection
        settings = get_settings()
        
        # Construct Redis URL from settings
        redis_url = f"redis://"
        if settings.redis_password:
            redis_url += f":{settings.redis_password}@"
        redis_url += f"{settings.redis_host}:{settings.redis_port}/{settings.redis_db}"
        
        redis_client = redis.from_url(redis_url)
        
        # Find the user phone number by checking all cached images
        # If user_phone is provided, use that; otherwise find the most recent cache
        target_user_phone = user_phone
        image_data = None
        cache_key = None
        
        if target_user_phone:
            # Use specified user phone
            cache_key = f"user_images:{target_user_phone}"
            cached_data = redis_client.get(cache_key)
            if cached_data:
                image_data = json.loads(cached_data)
        else:
            # Find the most recent cache (by uploaded_at timestamp)
            most_recent_time = None
            most_recent_user = None
            
            for key in redis_client.scan_iter(match="user_images:*"):
                key_str = key.decode('utf-8')
                cached_data = redis_client.get(key)
                if cached_data:
                    data = json.loads(cached_data)
                    uploaded_at = data.get("uploaded_at", "")
                    if not most_recent_time or uploaded_at > most_recent_time:
                        most_recent_time = uploaded_at
                        most_recent_user = key_str.replace("user_images:", "")
                        image_data = data
                        cache_key = key_str
            
            target_user_phone = most_recent_user
        
        if not target_user_phone or not image_data:
            return {
                "success": False,
                "total_images": 0,
                "analyzed_images": 0,
                "individual_analyses": [],
                "overall_analysis": "",
                "processing_timestamp": "",
                "message": "No cached images found. Please upload images first."
            }
        
        images = image_data.get("images", [])
        if not images:
            return {
                "success": False,
                "total_images": 0,
                "analyzed_images": 0,
                "individual_analyses": [],
                "overall_analysis": "",
                "processing_timestamp": "",
                "message": "No images found in cache."
            }
        
        # Analyze each image individually
        individual_analyses = []
        analyzed_count = 0
        
        for img in images:
            image_id = img.get("id")
            if not image_id:
                continue
                
            # Analyze the individual image directly (without calling other tools)
            try:
                image_url = img.get("url")
                if not image_url:
                    continue
                
                # Initialize vision-capable LLM
                llm = ChatOpenAI(
                    model="gpt-4o",  # Use GPT-4o for vision capabilities
                    temperature=0.1,
                    api_key=settings.openai_api_key
                )
                
                # Prepare analysis prompt
                full_prompt = f"{analysis_prompt}\n\nPlease analyze this image and provide a detailed description:"
                
                # Create message with image
                message_content = [
                    {"type": "text", "text": full_prompt},
                    {"type": "image_url", "image_url": {"url": image_url}}
                ]
                
                # Create human message with image
                human_message = HumanMessage(content=message_content)
                
                # Get analysis from LLM
                response = llm.invoke([human_message])
                analysis = response.content
                
                # Update the cache with the analysis
                img["analyzed"] = True
                img["analysis"] = analysis
                img["analysis_timestamp"] = datetime.now().isoformat()
                
                analyzed_count += 1
                individual_analyses.append({
                    "image_id": image_id,
                    "analysis": analysis,
                    "analysis_timestamp": img["analysis_timestamp"]
                })
                
                logger.info(f"Analyzed individual image {image_id} for user {target_user_phone}")
                
            except Exception as e:
                logger.error(f"Error analyzing individual image {image_id}: {e}")
                continue
        
        # Save updated cache with analysis results
        if analyzed_count > 0:
            redis_client.setex(cache_key, 3600, json.dumps(image_data))  # 1 hour expiration
        
        # Generate overall analysis if we have individual analyses
        overall_analysis = ""
        if individual_analyses:
            # Initialize LLM for overall analysis
            llm = ChatOpenAI(
                model="gpt-4o-mini",  # Use cheaper model for text analysis
                temperature=0.1,
                api_key=settings.openai_api_key
            )
            
            # Prepare overall analysis prompt
            individual_text = "\n\n".join([
                f"Image {i+1} Analysis:\n{analysis['analysis']}" 
                for i, analysis in enumerate(individual_analyses)
            ])
            
            overall_prompt = f"""Based on the following individual image analyses, provide a comprehensive overall summary and insights:

{individual_text}

Please provide:
1. A summary of what you see across all images
2. Common themes or patterns
3. Overall assessment or conclusions
4. Any notable differences between images

Overall Analysis:"""
            
            # Get overall analysis from LLM
            response = llm.invoke([HumanMessage(content=overall_prompt)])
            overall_analysis = response.content
        
        processing_timestamp = datetime.now().isoformat()
        
        logger.info(f"Processed {analyzed_count}/{len(images)} images for user {target_user_phone}")
        
        # Clear cache immediately after analysis
        redis_client.delete(cache_key)
        logger.info(f"Cleared cache for user {target_user_phone} after analysis")
        
        return {
            "success": True,
            "total_images": len(images),
            "analyzed_images": analyzed_count,
            "individual_analyses": individual_analyses,
            "overall_analysis": overall_analysis,
            "processing_timestamp": processing_timestamp,
            "message": f"Successfully processed {analyzed_count} out of {len(images)} images. Cache cleared."
        }
        
    except Exception as e:
        logger.error(f"Error processing all cached images: {e}")
        return {
            "success": False,
            "total_images": 0,
            "analyzed_images": 0,
            "individual_analyses": [],
            "overall_analysis": "",
            "processing_timestamp": "",
            "message": f"Failed to process images: {str(e)}"
        }


@tool
@traceable(name="analyze_multiple_images_with_vision")
def analyze_multiple_images_with_vision(user_phone: str, analysis_prompt: str = None) -> Dict[str, Any]:
    """
    Analyze multiple cached images using the enhanced image analyzer with single-call multi-image analysis.
    
    WORKFLOW:
    1. Retrieve cached images for the user from Redis
    2. Use the analyze_multiple_images_single_call method for comparative analysis
    3. Return comprehensive analysis results
    4. Clear cache after analysis
    
    Args:
        user_phone: User's phone number
        analysis_prompt: Custom prompt for analysis (optional)
        
    Returns:
        Dictionary with analysis results:
        {
            "success": bool,
            "analysis": str,
            "image_count": int,
            "tokens_used": int,
            "model_used": str,
            "analysis_timestamp": str,
            "message": str
        }
        Use a single asterisk (*John Doe*) on each side whenever you make text bold; don't use double asterisks.
    """
    try:
        import redis
        import json
        from datetime import datetime
        import sys
        import os
        
        # Add the project root to Python path to import image_analyzer
        project_root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
        sys.path.insert(0, project_root)
        
        from image_analyzer import ImageAnalyzer
        
        # Get Redis connection
        settings = get_settings()
        
        # Construct Redis URL from settings
        redis_url = f"redis://"
        if settings.redis_password:
            redis_url += f":{settings.redis_password}@"
        redis_url += f"{settings.redis_host}:{settings.redis_port}/{settings.redis_db}"
        
        redis_client = redis.from_url(redis_url)
        
        # Create cache key
        cache_key = f"user_images:{user_phone}"
        processing_key = f"processing:{user_phone}"
        
        # Check if analysis is already in progress
        if redis_client.get(processing_key):
            logger.warning(f"Analysis already in progress for user {user_phone}")
            return {
                "success": False,
                "analysis": "",
                "image_count": 0,
                "tokens_used": 0,
                "model_used": "",
                "analysis_timestamp": "",
                "message": "Analysis is already in progress. Please wait."
            }
        
        # Set processing lock (expires in 2 minutes)
        redis_client.setex(processing_key, 120, "processing")
        
        try:
            # Retrieve cached images
            cached_data = redis_client.get(cache_key)
            if not cached_data:
                return {
                    "success": False,
                    "analysis": "",
                    "image_count": 0,
                    "tokens_used": 0,
                    "model_used": "",
                    "analysis_timestamp": "",
                    "message": "No cached images found. Please upload images first."
                }
            
            # Parse cached data
            image_data = json.loads(cached_data)
            image_urls = image_data.get("image_urls", [])
            
            if not image_urls:
                return {
                    "success": False,
                    "analysis": "",
                    "image_count": 0,
                    "tokens_used": 0,
                    "model_used": "",
                    "analysis_timestamp": "",
                    "message": "No images found in cache for this user."
                }
            
            # Initialize the enhanced image analyzer
            analyzer = ImageAnalyzer(model="gpt-4o")
            
            # Use the multi-image single-call analysis
            result = analyzer.analyze_multiple_images_single_call(image_urls, analysis_prompt)
            
            # Clear cache after analysis
            redis_client.delete(cache_key)
            
            analysis_timestamp = datetime.now().isoformat()
            
            if result["success"]:
                logger.info(f"Successfully analyzed {len(image_urls)} images for user {user_phone} using multi-image analysis")
                
                return {
                    "success": True,
                    "analysis": result["analysis"],
                    "image_count": len(image_urls),
                    "tokens_used": result.get("tokens_used", 0),
                    "model_used": result.get("model_used", "gpt-4o"),
                    "analysis_timestamp": analysis_timestamp,
                    "message": f"Successfully analyzed {len(image_urls)} images with comparative analysis"
                }
            else:
                logger.error(f"Failed to analyze images for user {user_phone}: {result.get('error')}")
                return {
                    "success": False,
                    "analysis": "",
                    "image_count": len(image_urls),
                    "tokens_used": 0,
                    "model_used": "",
                    "analysis_timestamp": analysis_timestamp,
                    "message": f"Failed to analyze images: {result.get('error', 'Unknown error')}"
                }
                
        finally:
            # Always clear the processing lock
            redis_client.delete(processing_key)
        
    except Exception as e:
        logger.error(f"Error analyzing multiple images for user {user_phone}: {e}")
        return {
            "success": False,
            "analysis": "",
            "image_count": 0,
            "tokens_used": 0,
            "model_used": "",
            "analysis_timestamp": "",
            "message": f"Failed to analyze images: {str(e)}"
        }


# @tool
# @traceable(name="start_new_trade_in_session")
# def start_new_trade_in_session(user_phone: str) -> Dict[str, Any]:
#     """
#     Start a new trade-in session by clearing all previous cached images.
    
#     WORKFLOW:
#     1. Clear all cached images for the user
#     2. Reset session state
#     3. Confirm new session started
    
#     Args:
#         user_phone: User's phone number
        
#     Returns:
#         Dictionary with session start result:
#         {
#             "success": bool,
#             "message": str,
#             "session_cleared": bool
#         }
#     """
