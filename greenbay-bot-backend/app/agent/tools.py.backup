@tool
@traceable(name="get_user_info")
def get_user_info(user_phone: str = "") -> Dict[str, Any]:
    """
    Get user information including name from the database.
    
    CRITICAL: This tool MUST be called FIRST in every new conversation to get the user's name for personalization.
    The user's name is automatically extracted from WhatsApp webhook and stored in the database.
    
    WORKFLOW:
    1. Query database for user by phone number (automatically gets phone from context if not provided)
    2. Return user's name and other information
    3. Use the name to address the customer personally in your introduction
    
    WHEN TO CALL:
    - ALWAYS call this FIRST before introducing yourself in a new conversation
    - The name is extracted from WhatsApp webhook contacts and stored automatically
    - If name exists, use it in your greeting: "Hi [Name]! I'm Kay..."
    
    Args:
        user_phone: User's phone number (optional, will be extracted from context if not provided)
        
    Returns:
        Dictionary with user information:
        {
            "success": bool,
            "name": str (or None if not set),
            "phone_number": str,
            "email": str,
            "default_address": str,
            "message": str
        }
        Use a single asterisk (*John Doe*) on each side whenever you make text bold; don't use double asterisks.
    """
    try:
        from app.database.db import get_db
        from app.database.models import User
        
        # If no user_phone provided, get from context
        if not user_phone:
            user_phone = _get_current_user_phone()
        
        db = next(get_db())
        try:
            user = db.query(User).filter(User.phone_number == user_phone).first()
            
            if not user:
                return {
                    "success": False,
                    "name": None,
                    "phone_number": user_phone,
                    "email": None,
                    "default_address": None,
                    "message": f"No user found with phone number {user_phone}"
                }
            
            return {
                "success": True,
                "name": user.name,
                "phone_number": user.phone_number,
                "email": user.email,
                "default_address": user.default_address,
                "message": f"User found: {user.name if user.name else 'Name not set'}"
            }
        finally:
            db.close()
            
    except Exception as e:
        logger.error(f"Error getting user info: {e}")
        return {
            "success": False,
            "name": None,
            "phone_number": user_phone,
            "email": None,
            "default_address": None,
            "message": f"Error retrieving user info: {str(e)}"
        }


