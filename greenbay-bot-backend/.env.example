# =============================================================================
# GreenBay AI Evaluator - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# REQUIRED keys are marked with [REQUIRED]
# OPTIONAL keys have sensible defaults
# =============================================================================

# -----------------------------------------------------------------------------
# AI / LLM Configuration
# -----------------------------------------------------------------------------

# [REQUIRED] Anthropic API Key - Powers AI vision analysis, model label OCR, and chat
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# [REQUIRED] OpenAI API Key - Powers the WhatsApp agent
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Models (defaults are fine for production)
ANTHROPIC_PRIMARY_MODEL=claude-opus-4-20250514
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# WhatsApp Business API
# -----------------------------------------------------------------------------

# [REQUIRED for WhatsApp] Meta WhatsApp Business API credentials
# Get from: Meta Business Manager > WhatsApp > API Setup
ACCESS_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=your_chosen_verify_token
CATALOG_ID=
APP_ID=
APP_SECRET=
VERSION=v23.0

# -----------------------------------------------------------------------------
# M-Pesa Daraja API (Payments)
# -----------------------------------------------------------------------------

# [REQUIRED for payments] Get from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_PHONE_NUMBER=
MPESA_CALLBACK_URL=https://yourdomain.com/mpesa/callback

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# SQLite (default, works out of the box)
DATABASE_URL=sqlite:///./greenbay_chatbot.db

# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/greenbay_market
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=greenbay_market
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_db_password

# -----------------------------------------------------------------------------
# Redis (session persistence)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=9300
REDIS_DB=0
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Vector Database (Qdrant)
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:9400
# QDRANT_API_KEY=
QDRANT_COLLECTION=products

# -----------------------------------------------------------------------------
# AWS S3 (optional, for image storage)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-north-1
# S3_BUCKET=greenbay-bucket

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=greenbay-chatbot
LANGSMITH_TRACING_V2=true

# Tavily search (optional, for web search)
# TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=GreenBay Market Chatbot
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_random_secret_key

# CORS (comma-separated additional origins)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Store info
STORE_NAME=GreenBay Market
STORE_ADDRESS=Amani Gardens, 71 Church Road, Nairobi, Kenya
STORE_PHONE=+2540205002173
STORE_EMAIL=info@greenbay.market
