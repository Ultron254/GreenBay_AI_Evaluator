# =============================================================================
# GreenBay AI Evaluator — environment template
#
# Copy to .env and fill in. Anything under "REQUIRED" must be set or the
# platform will refuse to quote prices.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Anthropic Claude (vision: reads the photos and grades condition)
# Without this the evaluator returns HTTP 503 instead of guessing a grade.
# Set up billing with auto-reload; a zero balance takes the whole product down.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_PRIMARY_MODEL=claude-opus-4-20250514
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# REQUIRED — Google Vertex AI (Gemini). Powers the grounded new-price lookup
# AND is reused for Google Sheets auth. Same service-account JSON for both.
# -----------------------------------------------------------------------------
GOOGLE_VERTEX_CREDENTIALS_FILE=/app/credentials/greenbay-ai-evaluator-service-account.json
GOOGLE_VERTEX_PROJECT=greenbay-ai-evaluator
GOOGLE_VERTEX_REGION=us-central1
GOOGLE_VERTEX_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# REQUIRED — Google Sheets (pricing matrix, sales stock, tracker sheet).
# Share each sheet with the service-account email as Editor.
# Falls back to the Vertex credentials above if this is left blank.
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_CREDENTIALS_FILE=/app/credentials/greenbay-ai-evaluator-service-account.json
GOOGLE_SHEETS_ID=1DCKTWSxvGYQzuEPoJanQFF5ssM9oWnqVmEoEmh1MhAU

# -----------------------------------------------------------------------------
# REQUIRED — Airtable (record store + human review surface)
# -----------------------------------------------------------------------------
AIRTABLE_API_TOKEN=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=Appliance Evaluations

# -----------------------------------------------------------------------------
# REQUIRED — Perplexity Sonar. Second independent new-price source that
# cross-checks Gemini. When both agree, confidence rises ~15 points, which is
# what keeps evaluations out of the manual review queue.
# -----------------------------------------------------------------------------
PERPLEXITY_API_KEY=pplx-...

# -----------------------------------------------------------------------------
# REQUIRED — AWS S3 (stores customer photos so the CX handoff email can show
# them). IAM user needs only s3:PutObject + s3:GetObject on this bucket.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=greenbay-evaluator-images

# -----------------------------------------------------------------------------
# REQUIRED — Email alerts (accepted/rejected offers + service-down alarms).
# SMTP via Google Workspace is the simplest route: create a dedicated mailbox,
# enable 2FA on it, then generate a 16-character App Password.
# If SMTP_HOST is set, AWS SES is not used at all.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=evaluator@greenbay.market
SMTP_PASSWORD=
SMTP_FROM=evaluator@greenbay.market
TEAM_NOTIFICATION_EMAILS=allanmatano@greenbay.market,alexander@greenbay.market

# -----------------------------------------------------------------------------
# REQUIRED — Admin gate for the ops dashboard and all /admin endpoints.
# Generate with:  openssl rand -hex 32
# -----------------------------------------------------------------------------
DASHBOARD_KEY=change-me-to-a-long-random-secret

# -----------------------------------------------------------------------------
# Service monitor — health-check loop that emails the moment anything breaks.
# -----------------------------------------------------------------------------
MONITOR_ENABLED=true
MONITOR_INTERVAL_MIN=5

# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@postgres:5432/greenbay_market
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=products

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=GreenBay Market Chatbot
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO
SECRET_KEY=
CORS_ORIGINS=https://greenbay.market,https://www.greenbay.market,https://evaluate.greenbay.market

# -----------------------------------------------------------------------------
# Store details
# -----------------------------------------------------------------------------
STORE_NAME=GreenBay Market
STORE_ADDRESS=Amani Gardens, 71 Church Road, Nairobi, Kenya
STORE_PHONE=+2540205002173
STORE_EMAIL=info@greenbay.market

# -----------------------------------------------------------------------------
# Pulse read-only access. Pulse polls the reporting routes with this key and
# never holds DASHBOARD_KEY, so it can read metrics but cannot run admin jobs.
# Generate with:  openssl rand -hex 32
# -----------------------------------------------------------------------------
READONLY_DASHBOARD_KEY=change-me-to-a-different-long-random-secret

# -----------------------------------------------------------------------------
# Perplexity model override, and how often the health-check is allowed to make
# the PAID probes (Gemini grounding + Sonar). The monitor ran them every 10
# minutes, which burned roughly 288 Sonar calls a day on its own.
# -----------------------------------------------------------------------------
PERPLEXITY_MODEL=sonar
HEALTH_PAID_PROBE_INTERVAL_MIN=360

# Opt-in: rescale confidence when a price source is down, so the score reflects
# the evidence actually available rather than silently losing points.
CONFIDENCE_RENORMALISE_UNAVAILABLE_SOURCES=false

# =============================================================================
# INTENTIONALLY NOT USED — do not re-add without reading the note.
#
#   WhatsApp Cloud API (ACCESS_TOKEN / PHONE_NUMBER_ID / APP_ID / APP_SECRET)
#       The evaluator hands off to a human with a wa.me deep link plus an email
#       carrying the summary and photos. No inbound webhook is required.
#   OPENAI_API_KEY
#       Only powered the separate WhatsApp shopping agent, which is disabled.
#   TAVILY_API_KEY
#       Superseded by Gemini search grounding.
#   LANGSMITH_API_KEY
#       Optional LLM tracing. Leave unset unless actively debugging.
#   M-Pesa (MPESA_*)
#       Payments are handled offline by the sourcing team after inspection.
#   AWS SES (SES_SENDER_EMAIL / SES_REGION)
#       Superseded by SMTP above. SES needs sender-identity verification.
# =============================================================================
