# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# WhatsApp Business API Configuration
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhook/whatsapp

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:9400
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=products

# Shopify Configuration
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here
SHOPIFY_API_VERSION=2025-10
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# M-Pesa Daraja API Configuration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_SHORTCODE=your_mpesa_shortcode_here
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_ENVIRONMENT=sandbox  # or production
MPESA_CALLBACK_URL=https://your-domain.com/webhook/mpesa/callback

# Database Configuration
DATABASE_URL=sqlite:///./greenbay_chatbot.db
# For PostgreSQL: postgresql://username:password@localhost/greenbay_chatbot

# Redis Configuration (for session storage)
REDIS_URL=redis://localhost:9300/0

# AWS S3 Configuration (for image storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=greenbay-images

# AWS SES — team email notifications on accepted offers (issue #13)
# The sender MUST be a verified identity in SES (or the whole domain verified).
# If your SES account is still in sandbox, the recipients must also be verified.
SES_SENDER_EMAIL=evaluator@greenbay.market
SES_REGION=us-east-1
TEAM_NOTIFICATION_EMAILS=allanmatano@greenbay.market,kelvin@greenbay.market

# Admin/ops endpoints gate (live health-check, Airtable backfill, dashboard).
# CHANGE THIS to a long random secret — the default is public knowledge.
DASHBOARD_KEY=change-me-to-a-long-random-secret

# Application Configuration
APP_NAME=GreenBay Market Chatbot
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# Security
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# GreenBay Market Store Information
STORE_NAME=GreenBay Market
STORE_ADDRESS=Amani Gardens, 71 Church Road, Nairobi, Kenya
STORE_PHONE=+2540205002173
STORE_EMAIL=info@greenbay.market

# Delivery Configuration (Jumia Integration)
JUMIA_DELIVERY_ZONES_CONFIG=./config/delivery_zones.json

# Trade-in Configuration
TRADEIN_MIN_VALUE=1000
TRADEIN_MAX_VALUE=500000
TRADEIN_IMAGE_MAX_SIZE_MB=10
TRADEIN_ALLOWED_FORMATS=jpg,jpeg,png,webp

# Payment Configuration
PAYMENT_TIMEOUT_MINUTES=10
PAYMENT_RETRY_ATTEMPTS=3

# Session Configuration
SESSION_TIMEOUT_HOURS=24
CONVERSATION_TIMEOUT_HOURS=2

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# LangSmith Monitoring
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=greenbay-chatbot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_V2=true
